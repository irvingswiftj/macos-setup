#!/bin/sh
# One-time bootstrap for a fresh Mac. Installs just enough (Xcode Command Line
# Tools, Homebrew, Ansible) to run the playbook, then runs it.
# After this, use bin/apply to re-run the playbook.
set -e

cd "$(dirname "$0")/.."

# Everything here (and in the playbook and zshrc template) assumes Homebrew at
# /opt/homebrew, i.e. an Apple Silicon Mac.
if [ "$(uname -m)" != "arm64" ]; then
  echo "This setup only supports Apple Silicon Macs (Homebrew at /opt/homebrew)." >&2
  exit 1
fi

# Xcode Command Line Tools (git, compilers; required by Homebrew)
if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install
  echo
  echo "Finish the Command Line Tools install dialog, then re-run bin/bootstrap."
  exit 1
fi

# Homebrew
if [ ! -x /opt/homebrew/bin/brew ]; then
  installer="$(mktemp)"
  trap 'rm -f "$installer"' 0
  if ! curl -fsSL -o "$installer" https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh; then
    echo "Failed to download the Homebrew installer." >&2
    exit 1
  fi
  /bin/bash "$installer"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# Ansible, with its own Python, so nothing is installed into the system Python
brew install ansible

ansible-galaxy install -r requirements.yml
ansible-playbook -i "localhost," -c local ansible_osx.yml --ask-become-pass
