# This file is auto-generated by ansible, do not change this file directly.
# It is overwritten every time bin/apply runs. Put personal config in:
#   ~/.zshrc.personal.before  - runs before Oh My Zsh loads (e.g. ZSH_THEME)
#   ~/.zshrc.personal.after   - everything else: aliases, API keys, extra PATH entries

# Homebrew
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# Keg-only Homebrew packages that are not linked into /opt/homebrew/bin
export PATH="/opt/homebrew/opt/imagemagick@6/bin:$PATH"
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="${PATH}:${ANDROID_HOME}/tools:${ANDROID_HOME}/platform-tools"

# Build flags for native extensions (ruby gems, python packages)
export optflags="-Wno-error=implicit-function-declaration"
export LDFLAGS="-L/opt/homebrew/opt/libffi/lib"
export CPPFLAGS="-I/opt/homebrew/opt/libffi/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/libffi/lib/pkgconfig:/opt/homebrew/opt/zlib/lib/pkgconfig"

# ZSH setup
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git kubectl)
DISABLE_UNTRACKED_FILES_DIRTY="true"
ZSH_DISABLE_COMPFIX=true

# Load personal pre oh-my-zsh init config which should be stored in ~/.zshrc.personal.before
# E.g. setting ZSH theme etc
if [ -f ~/.zshrc.personal.before ]; then . ~/.zshrc.personal.before; fi

# Load Oh My Zsh
source "$ZSH/oh-my-zsh.sh"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# nvm (installed via Homebrew)
export NVM_DIR="$HOME/.nvm"

# Put nvm's default node on PATH without sourcing nvm.sh, so that scripts with
# a `#!/usr/bin/env node` shebang (e.g. eas, pnpm globals) use the same version
# as a direct `node` call, without paying the nvm startup cost in every shell.
# Resolves the `default` alias the way nvm does: a version dir, an alias chain
# such as `lts/*` -> `lts/krypton` -> `v24.x`, or a partial version like `24`.
_nvm_resolve() {
  local v="$1" i
  for i in 1 2 3 4 5; do
    [ -z "$v" ] && return
    [ -d "$NVM_DIR/versions/node/$v" ] && { echo "$v"; return; }
    if [ -f "$NVM_DIR/alias/$v" ]; then v="$(cat "$NVM_DIR/alias/$v")"; continue; fi
    local -a m
    m=( "$NVM_DIR/versions/node/v${v#v}"*(N) )
    [ -n "${m[1]}" ] && printf '%s\n' "${m[@]}" | sort -V | tail -1 | sed 's|.*/||'
    return
  done
}
_nvm_default="$(_nvm_resolve "$(cat "$NVM_DIR/alias/default" 2>/dev/null)")"
# No default alias yet (e.g. first run): fall back to the newest installed node.
[ -z "$_nvm_default" ] && _nvm_default="$(ls "$NVM_DIR/versions/node" 2>/dev/null | sort -V | tail -1)"
[ -n "$_nvm_default" ] && export PATH="$NVM_DIR/versions/node/$_nvm_default/bin:$PATH"
unset -f _nvm_resolve; unset _nvm_default

# Lazy-load nvm itself the first time nvm/node/npm/npx is called.
_load_nvm() {
  unset -f nvm node npm npx
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
}
nvm()  { _load_nvm; nvm "$@"; }
node() { _load_nvm; node "$@"; }
npm()  { _load_nvm; npm "$@"; }
npx()  { _load_nvm; npx "$@"; }

# Auto-switch node version on `cd` when a .nvmrc is in scope. nvm itself is only
# loaded the first time a .nvmrc is actually encountered, so startup stays fast.
autoload -U add-zsh-hook
_find_nvmrc() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/.nvmrc" ] && { echo "$d/.nvmrc"; return; }
    d="$(dirname "$d")"
  done
}
load-nvmrc() {
  local nvmrc_path="$(_find_nvmrc)"
  if [ -n "$nvmrc_path" ]; then
    nvm --version >/dev/null   # triggers the lazy load on first use
    local nvmrc_node_version="$(nvm version "$(cat "$nvmrc_path")")"
    if [ "$nvmrc_node_version" = "N/A" ]; then
      nvm install
    elif [ "$nvmrc_node_version" != "$(nvm version)" ]; then
      nvm use
    fi
  elif whence -w nvm_find_nvmrc >/dev/null 2>&1 && [ "$(nvm version)" != "$(nvm version default)" ]; then
    echo "Reverting to nvm default version"
    nvm use default
  fi
}
add-zsh-hook chpwd load-nvmrc
load-nvmrc   # also apply a .nvmrc in the directory the shell starts in

# Tools that install themselves into ~/.local/bin (e.g. Claude Code, pipx).
# Kept late so these win over older copies installed via pnpm/npm.
export PATH="$HOME/.local/bin:$PATH"

# Load personal ZSH config which should be stored in ~/.zshrc.personal.after
# Most ZSH config e.g. aliases etc goes here
if [ -f ~/.zshrc.personal.after ]; then . ~/.zshrc.personal.after; fi
